rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAuth() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'phone'
      );
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'kurumsalpark@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedAuth() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(ownerUid) {
      return isVerifiedAuth() && request.auth.uid == ownerUid;
    }

    function isValidAdminMember(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
        data.createdAt is timestamp;
    }

    function isValidWorkspaceVault(data) {
      return data.keys().hasAll([
          'ownerId',
          'schemaVersion',
          'dealersJson',
          'subscribersJson',
          'profilesJson',
          'settingsJson',
          'operationsJson',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'schemaVersion',
          'dealersJson',
          'subscribersJson',
          'profilesJson',
          'settingsJson',
          'operationsJson',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 1000 &&
        data.dealersJson is string && data.dealersJson.size() <= 450000 &&
        data.subscribersJson is string && data.subscribersJson.size() <= 450000 &&
        data.profilesJson is string && data.profilesJson.size() <= 450000 &&
        data.settingsJson is string && data.settingsJson.size() <= 350000 &&
        data.operationsJson is string && data.operationsJson.size() <= 450000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspaceVaultAdminOverride(data) {
      return data.keys().hasAll([
          'ownerId',
          'schemaVersion',
          'dealersJson',
          'subscribersJson',
          'profilesJson',
          'settingsJson',
          'operationsJson',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'schemaVersion',
          'dealersJson',
          'subscribersJson',
          'profilesJson',
          'settingsJson',
          'operationsJson',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 1000 &&
        data.dealersJson is string && data.dealersJson.size() <= 450000 &&
        data.subscribersJson is string && data.subscribersJson.size() <= 450000 &&
        data.profilesJson is string && data.profilesJson.size() <= 450000 &&
        data.settingsJson is string && data.settingsJson.size() <= 350000 &&
        data.operationsJson is string && data.operationsJson.size() <= 450000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspaceSnapshot(data, workspaceId) {
      return data.keys().hasAll([
          'ownerId',
          'workspaceId',
          'label',
          'payloadJson',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'workspaceId',
          'label',
          'payloadJson',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.workspaceId is string && data.workspaceId.size() >= 1 && data.workspaceId.size() <= 128 && data.workspaceId == workspaceId &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
        data.payloadJson is string && data.payloadJson.size() <= 850000 &&
        data.status is string && data.status.size() <= 16 && (data.status == 'ACTIVE' || data.status == 'LOCKED') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspaceSnapshotAdminOverride(data, workspaceId) {
      return data.keys().hasAll([
          'ownerId',
          'workspaceId',
          'label',
          'payloadJson',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'workspaceId',
          'label',
          'payloadJson',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.workspaceId is string && data.workspaceId.size() >= 1 && data.workspaceId.size() <= 128 && data.workspaceId == workspaceId &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
        data.payloadJson is string && data.payloadJson.size() <= 850000 &&
        data.status is string && data.status.size() <= 16 && (data.status == 'ACTIVE' || data.status == 'LOCKED') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Trusted Admin Registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isBootstrappedAdmin());
      allow list: if false;
      allow create: if isBootstrappedAdmin() &&
        isValidId(adminId) &&
        isValidAdminMember(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(adminId);
    }

    // Owner-Isolated Persistent Workspace Vault
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) && (isOwner(workspaceId) || isAdmin());
      allow list: if false;

      allow create: if isVerifiedAuth() &&
        isValidId(workspaceId) &&
        isValidWorkspaceVault(incoming()) &&
        workspaceId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedAuth() &&
        isValidId(workspaceId) &&
        (
          (
            isValidWorkspaceVault(incoming()) &&
            isOwner(workspaceId) &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'schemaVersion',
              'dealersJson',
              'subscribersJson',
              'profilesJson',
              'settingsJson',
              'operationsJson',
              'updatedAt'
            ])
          ) ||
          (
            isValidWorkspaceVaultAdminOverride(incoming()) &&
            isAdmin() &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'schemaVersion',
              'dealersJson',
              'subscribersJson',
              'profilesJson',
              'settingsJson',
              'operationsJson',
              'updatedAt'
            ])
          )
        );

      allow delete: if isBootstrappedAdmin() && isValidId(workspaceId);

      // Relational Subcollection: Snapshots (Protected by Master Gate)
      match /snapshots/{snapshotId} {
        allow get: if isSignedIn() &&
          isValidId(workspaceId) &&
          isValidId(snapshotId) &&
          (
            (
              isOwner(workspaceId) &&
              exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
              get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
            ) ||
            isAdmin()
          );

        allow list: if isVerifiedAuth() && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedAuth() &&
          isValidId(workspaceId) &&
          isValidId(snapshotId) &&
          isValidWorkspaceSnapshot(incoming(), workspaceId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;

        allow update: if isVerifiedAuth() &&
          isValidId(workspaceId) &&
          isValidId(snapshotId) &&
          (
            (
              isValidWorkspaceSnapshot(incoming(), workspaceId) &&
              existing().status != 'LOCKED' &&
              incoming().ownerId == existing().ownerId &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().createdAt == existing().createdAt &&
              incoming().updatedAt == request.time &&
              exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
              get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid &&
              (
                // Action: Refresh Snapshot Payload
                incoming().diff(existing()).affectedKeys().hasOnly(['label', 'payloadJson', 'updatedAt']) ||
                // Action: Lock Snapshot
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              )
            ) ||
            (
              isValidWorkspaceSnapshotAdminOverride(incoming(), workspaceId) &&
              isAdmin() &&
              incoming().ownerId == existing().ownerId &&
              incoming().workspaceId == existing().workspaceId &&
              incoming().createdAt == existing().createdAt &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['label', 'payloadJson', 'status', 'updatedAt'])
            )
          );

        allow delete: if isBootstrappedAdmin() && isValidId(workspaceId) && isValidId(snapshotId);
      }
    }
  }
}
